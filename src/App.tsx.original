const queryClient = new QueryClient();

// Protected Route Component
function ProtectedRoute({ children }: { children: React.ReactNode }) {
  const isAuthenticated = localStorage.getItem("xpress_auth") === "true";

  if (!isAuthenticated) {
    return <Navigate to="/login" replace />;
  }

  return <DashboardLayout>{children}</DashboardLayout>;
}

// Redirect components for legacy routes
function JobTypesEditRedirect() {
  const { id } = useParams();
  return <Navigate to={`/job-management/job-types/${id}/edit`} replace />;
}

function CareersEditRedirect() {
  const { id } = useParams();
  return <Navigate to={`/job-management/careers/${id}/edit`} replace />;
}

