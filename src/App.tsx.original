          />

          {/* Location Features Routes */}
          <Route
            path="/location-management/:locationId/features"
            element={
              <ProtectedRoute>
                <LocationFeaturesList />
              </ProtectedRoute>
            }
          />

          <Route
            path="/location-management/:locationId/features/new"
            element={
              <ProtectedRoute>
                <LocationFeaturesForm />
              </ProtectedRoute>
            }
          />

          <Route
            path="/location-management/:locationId/features/:id/edit"
            element={
              <ProtectedRoute>
                <LocationFeaturesForm />
              </ProtectedRoute>
            }
          />

          {/* Location Advertisements Routes */}
          <Route
            path="/location-management/:locationId/advertisements"
            element={
              <ProtectedRoute>
                <LocationAdvertisementList />
              </ProtectedRoute>
            }
          />

          <Route
            path="/location-management/:locationId/advertisements/new"
            element={
              <ProtectedRoute>
                <LocationAdvertisementForm />
              </ProtectedRoute>
            }
          />

          <Route
            path="/location-management/:locationId/advertisements/:id/edit"
            element={
              <ProtectedRoute>
                <LocationAdvertisementForm />
              </ProtectedRoute>
            }
          />

          {/* Location FAQ Routes */}
          <Route
            path="/location-management/:locationId/faq"
            element={
              <ProtectedRoute>
                <LocationFaqList />
              </ProtectedRoute>
            }
          />

          <Route
            path="/location-management/:locationId/faq/new"
            element={
              <ProtectedRoute>
                <LocationFaqForm />
              </ProtectedRoute>
            }
          />

          <Route
            path="/location-management/:locationId/faq/:id/edit"
            element={
              <ProtectedRoute>
                <LocationFaqForm />
              </ProtectedRoute>
            }
          />

          {/* Location Testimonials Routes */}
          <Route
            path="/location-management/:locationId/testimonials"
            element={
              <ProtectedRoute>
                <LocationTestimonialsList />
              </ProtectedRoute>
            }
          />

          <Route
            path="/location-management/:locationId/testimonials/new"
            element={
              <ProtectedRoute>
                <LocationTestimonialsForm />
              </ProtectedRoute>
            }
          />

          <Route
            path="/location-management/:locationId/testimonials/:id/edit"
            element={
              <ProtectedRoute>
                <LocationTestimonialsForm />
              </ProtectedRoute>
            }
          />

          {/* ADD ALL CUSTOM ROUTES ABOVE THE CATCH-ALL "*" ROUTE */}
          <Route path="*" element={<NotFound />} />
        </Routes>
      </BrowserRouter>
    </TooltipProvider>
  </QueryClientProvider>
);

export default App;
